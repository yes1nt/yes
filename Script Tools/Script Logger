local function Encrypt(Text, Key)
    if type(Text) ~= "string" or Text == "" then
        return nil
    end
    if type(Key) ~= "string" or Key == "" then
        return nil
    end
    local Result = {}
    for i = 1, #Text do
        local A = string.byte(Text, i)
        local B = string.byte(
            Key,
            ((i - 1) % #Key) + 1
        )
        Result[#Result + 1] = string.format(
            "%02X",
            bit32.bxor(A, B)
        )
    end
    return table.concat(Result)
end
local function Decrypt(Text, Key)
    if type(Text) ~= "string" or Text == "" then
        return nil
    end
    if type(Key) ~= "string" or Key == "" then
        return nil
    end
    local Result = {}
    for i = 1, #Text, 2 do
        local A = tonumber(Text:sub(i, i + 1), 16)
        if not A then
            return nil
        end
        local B = string.byte(
            Key,
            (((i - 1) / 2) % #Key) + 1
        )
        Result[#Result + 1] = string.char(
            bit32.bxor(A, B)
        )
    end
    return table.concat(Result)
end
